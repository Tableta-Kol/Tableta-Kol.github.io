{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LK Stickwerk Order",
  "type": "object",
  "required": ["id", "status", "customer", "items", "createdAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["NEW", "QUOTE", "APPROVED", "EMBROIDERY", "READY", "SHIPPED", "CANCELLED"]
    },
    "customer": {
      "type": "object",
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string" },
        "company": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["textileType", "quantity"],
        "properties": {
          "textileType": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "color": { "type": "string" },
          "sizes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["size", "quantity"],
              "properties": {
                "size": { "type": "string" },
                "quantity": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "employeeNames": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "embroidery": {
      "type": "object",
      "properties": {
        "placement": { "type": "string" },
        "widthMm": { "type": "number", "minimum": 0 },
        "heightMm": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "storageId"],
        "properties": {
          "name": { "type": "string" },
          "storageId": { "type": "string" },
          "mimeType": { "type": "string" },
          "sha256": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "quote": {
      "type": "object",
      "properties": {
        "currency": { "type": "string", "default": "EUR" },
        "net": { "type": "number", "minimum": 0 },
        "tax": { "type": "number", "minimum": 0 },
        "gross": { "type": "number", "minimum": 0 },
        "validUntil": { "type": "string" }
      },
      "additionalProperties": false
    },
    "deadline": { "type": "string" },
    "internalNotes": { "type": "string" },
    "customerMessage": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1, "default": 1 }
  },
  "additionalProperties": false
}
